#!/bin/bash

set -euo pipefail

TARGET="/home/parkee/gasak-dist"
GIT_DIR="/home/parkee/gasak.git"
GO_BIN="/usr/local/go/bin/go"
ENV_FILE="$TARGET/.env"
PORT=9001
VAULT_PORT=9002
DEPLOY_TIMEOUT=30

GREEN='\033[0;32m'
YELLOW='\033[1;33m'
RED='\033[0;31m'
CYAN='\033[0;36m'
GREY='\033[0;90m'
BOLD='\033[1m'
RESET='\033[0m'

DEPLOY_START=$(date +%s)
SMOKE_FAILED=()

ok()   { echo -e "   ${GREEN}✔${RESET}  $1"; }
err()  { echo -e "   ${RED}✘${RESET}  $1"; }
info() { echo -e "   ${CYAN}→${RESET}  $1"; }
warn() { echo -e "   ${YELLOW}⚠${RESET}  $1"; }
dim()  { echo -e "   ${GREY}$1${RESET}"; }

header() {
    echo ""
    echo -e "${CYAN}  ──────────────────────────────────────────────────────${RESET}"
    echo -e "${CYAN}  $1${RESET}"
    echo -e "${CYAN}  ──────────────────────────────────────────────────────${RESET}"
}

wait_for_kill() {
    local pattern="$1"
    local timeout=10
    local elapsed=0
    pkill -f "$pattern" 2>/dev/null || true
    while pgrep -f "$pattern" > /dev/null 2>&1 && [ $elapsed -lt $timeout ]; do
        sleep 1
        elapsed=$((elapsed + 1))
    done
    if pgrep -f "$pattern" > /dev/null 2>&1; then
        pkill -9 -f "$pattern" 2>/dev/null || true
        sleep 1
    fi
}

wait_for_port() {
    local port="$1"
    local timeout="$2"
    local elapsed=0
    while ! curl -fs --max-time 2 "http://localhost:$port/health" > /dev/null 2>&1 && \
          ! curl -fs --max-time 2 "http://localhost:$port/status" > /dev/null 2>&1; do
        sleep 1
        elapsed=$((elapsed + 1))
        if [ $elapsed -ge $timeout ]; then
            return 1
        fi
    done
    return 0
}

clear
echo ""
echo -e "${CYAN}${BOLD}"
echo "  ██████╗  █████╗ ███████╗ █████╗ ██╗  ██╗"
echo "  ██╔════╝ ██╔══██╗██╔════╝██╔══██╗██║ ██╔╝"
echo "  ██║  ███╗███████║███████╗███████║█████╔╝ "
echo "  ██║   ██║██╔══██║╚════██║██╔══██║██╔═██╗ "
echo "  ╚██████╔╝██║  ██║███████║██║  ██║██║  ██╗"
echo "   ╚═════╝ ╚═╝  ╚═╝╚══════╝╚═╝  ╚═╝╚═╝  ╚═╝"
echo -e "${RESET}"
echo -e "  ${GREY}POST-RECEIVE DEPLOYMENT PIPELINE${RESET}"
echo -e "  ${GREY}$(date '+%A, %d %B %Y — %H:%M:%S WIB')${RESET}"
echo ""

# ─── 0. PREFLIGHT ────────────────────────────────────────────
header "[0/5] Preflight"

if [ ! -f "$ENV_FILE" ]; then
    err ".env tidak ditemukan di $ENV_FILE"
    exit 1
fi
ok ".env found"

set -a
source "$ENV_FILE"
set +a
ok ".env loaded"

if [ -z "${GASAK_DIST_TOKEN:-}" ]; then
    err "GASAK_DIST_TOKEN kosong di .env!"
    exit 1
fi
ok "GASAK_DIST_TOKEN validated"

if [ ! -x "$GO_BIN" ] && ! command -v go &> /dev/null; then
    err "Go binary tidak ditemukan!"
    exit 1
fi
[ -x "$GO_BIN" ] || GO_BIN=$(command -v go)
ok "Go compiler: $($GO_BIN version | awk '{print $3}')"

# ─── 1. CHECKOUT ─────────────────────────────────────────────
header "[1/5] Checkout"

mkdir -p "$TARGET"
git --work-tree="$TARGET" --git-dir="$GIT_DIR" checkout -f main
ok "Source extracted → $TARGET"

cd "$TARGET"

COMMIT_HASH=$(git --git-dir="$GIT_DIR" rev-parse --short HEAD)
COMMIT_MSG=$(git --git-dir="$GIT_DIR" log -1 --pretty=format:"%s")
COMMIT_AUTHOR=$(git --git-dir="$GIT_DIR" log -1 --pretty=format:"%an")
dim "Commit : $COMMIT_HASH — $COMMIT_MSG"
dim "Author : $COMMIT_AUTHOR"

# ─── 2. COMPILE ──────────────────────────────────────────────
header "[2/5] Build"

info "Building GASAK CLI (linux/amd64)..."
if GOOS=linux GOARCH=amd64 $GO_BIN build \
    -ldflags="-s -w -X main.BuildVersion=$(cat version.txt 2>/dev/null | tr -d '[:space:]' || echo 'dev') -X main.BuildCommit=$COMMIT_HASH" \
    -o gasak main.go vault.go; then
    BINARY_SIZE=$(du -sh gasak | cut -f1)
    ok "gasak compiled ($BINARY_SIZE)"
else
    err "Build GASAK CLI gagal!"
    exit 1
fi

info "Building GASAK Vault Server..."
if [ -f "vault-server.go" ]; then
    if $GO_BIN build -ldflags="-s -w" -o vault-server vault-server.go; then
        VAULT_SIZE=$(du -sh vault-server | cut -f1)
        ok "vault-server compiled ($VAULT_SIZE)"
    else
        err "Build Vault Server gagal!"
        exit 1
    fi
else
    warn "vault-server.go tidak ditemukan, skip"
fi

# ─── 3. GENERATE CHECKSUMS ───────────────────────────────────
header "[3/5] Integrity"

DIST_FILES=(
    "gasak"
    "vault-server"
    "install.sh"
    "serve.sh"
    "deploy_parkee.py"
    "settlement_rfs.py"
    "decode_and_merge.py"
    "log_cleaner.py"
    "reader_script.sh"
    "update_reader.sh"
    "reinstall-vault.sh"
    "ploc_method.py"
    "sync_ploc.sh"
)

> checksums.sha256
for f in "${DIST_FILES[@]}"; do
    if [ -f "$f" ]; then
        sha256sum "$f" >> checksums.sha256
        dim "  $f checksum generated"
    fi
done
ok "checksums.sha256 updated (${#DIST_FILES[@]} files)"

chmod +x serve.sh install.sh reinstall-vault.sh gasak-watchdog.sh 2>/dev/null || true
ok "Permissions set"

# ─── 4. RESTART SERVICES ─────────────────────────────────────
header "[4/5] Services"

info "Stopping Vault Server..."
wait_for_kill "vault-server"
ok "Vault Server stopped"

info "Starting Vault Server..."
nohup ./vault-server > vault_server.log 2>&1 &
VAULT_PID=$!

if wait_for_port $VAULT_PORT $DEPLOY_TIMEOUT; then
    ok "Vault Server running (PID: $VAULT_PID, Port: $VAULT_PORT)"
else
    err "Vault Server gagal start dalam ${DEPLOY_TIMEOUT}s!"
    err "Check: tail -20 $TARGET/vault_server.log"
    tail -5 vault_server.log 2>/dev/null | while read -r line; do dim "  $line"; done
    exit 1
fi

info "Stopping Distribution Server..."
wait_for_kill "serve.sh"
wait_for_kill "python3.*9001"
if lsof -i:${PORT} > /dev/null 2>&1; then
    fuser -k ${PORT}/tcp 2>/dev/null || true
    sleep 1
fi
ok "Distribution Server stopped"

info "Starting Distribution Server..."
nohup bash ./serve.sh > dist_server.log 2>&1 &
DIST_PID=$!

if wait_for_port $PORT $DEPLOY_TIMEOUT; then
    ok "Distribution Server running (PID: $DIST_PID, Port: $PORT)"
else
    err "Distribution Server gagal start dalam ${DEPLOY_TIMEOUT}s!"
    err "Check: tail -20 $TARGET/dist_server.log"
    tail -5 dist_server.log 2>/dev/null | while read -r line; do dim "  $line"; done
    exit 1
fi

# ─── 5. SMOKE TEST ───────────────────────────────────────────
header "[5/5] Smoke Test"

smoke_check() {
    local label="$1"
    local url="$2"
    local expected="${3:-200}"
    local status
    status=$(curl -s -o /dev/null -w "%{http_code}" \
        -H "X-Gasak-Token: ${GASAK_DIST_TOKEN}" \
        --max-time 5 "$url" 2>/dev/null || echo "000")
    if [ "$status" = "$expected" ]; then
        ok "$label → HTTP $status"
    else
        err "$label → HTTP $status (expected $expected)"
        SMOKE_FAILED+=("$label")
    fi
}

smoke_check "dist  /status"     "http://10.70.0.110:${PORT}/status"
smoke_check "dist  /install.sh" "http://10.70.0.110:${PORT}/install.sh"
smoke_check "dist  /gasak"      "http://10.70.0.110:${PORT}/gasak"
smoke_check "vault /health"     "http://10.70.0.110:${VAULT_PORT}/health"

DEPLOY_END=$(date +%s)
DEPLOY_DURATION=$((DEPLOY_END - DEPLOY_START))
VERSION=$(cat "$TARGET/version.txt" 2>/dev/null | tr -d '[:space:]' || echo "?")

echo ""
echo -e "${CYAN}${BOLD}  ══════════════════════════════════════════════════════${RESET}"

if [ ${#SMOKE_FAILED[@]} -eq 0 ]; then
    echo -e "${GREEN}${BOLD}  DEPLOYMENT SUKSES${RESET}"
else
    echo -e "${YELLOW}${BOLD}  DEPLOYMENT SELESAI DENGAN ISSUES${RESET}"
    for f in "${SMOKE_FAILED[@]}"; do
        echo -e "  ${RED}✘ $f${RESET}"
    done
fi

echo ""
echo -e "  ${GREY}Version   ${RESET}: ${GREEN}${VERSION}${RESET} ${GREY}(${COMMIT_HASH})${RESET}"
echo -e "  ${GREY}Duration  ${RESET}: ${CYAN}${DEPLOY_DURATION}s${RESET}"
echo -e "  ${GREY}Dist      ${RESET}: ${CYAN}http://10.70.0.110:${PORT}${RESET}"
echo -e "  ${GREY}Vault     ${RESET}: ${CYAN}http://10.70.0.110:${VAULT_PORT}${RESET}"
echo -e "${CYAN}${BOLD}  ══════════════════════════════════════════════════════${RESET}"
echo ""
