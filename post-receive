#!/bin/bash

# ─────────────────────────────────────────────────────────────
# GASAK - Git Post-Receive Hook (Bulletproof CI/CD Edition)
# Runs on server supeng after: git push deploy main
# ─────────────────────────────────────────────────────────────

TARGET="/home/parkee/gasak-dist"
GIT_DIR="/home/parkee/gasak.git"
GO_BIN="/usr/local/go/bin/go"
PORT=9001

GREEN='\033[0;32m'
YELLOW='\033[1;33m'
RED='\033[0;31m'
CYAN='\033[0;36m'
RESET='\033[0m'

ok()   { echo -e "   ${GREEN}✔ $1${RESET}"; }
err()  { echo -e "   ${RED}✘ $1${RESET}"; }
info() { echo -e "   ${CYAN}-> $1${RESET}"; }
warn() { echo -e "   ${YELLOW}⚠ $1${RESET}"; }

echo ""
echo -e "${CYAN}============================================${RESET}"
echo -e "${CYAN}  GASAK POST-RECEIVE DEPLOYMENT            ${RESET}"
echo -e "${CYAN}  $(date '+%Y-%m-%d %H:%M:%S')${RESET}"
echo -e "${CYAN}============================================${RESET}"

# ─── 0. PREFLIGHT — VALIDASI ENV SEBELUM NGAPA-NGAPAIN ───────
echo -e "\n${YELLOW}[0/5] Preflight check...${RESET}"

# Validasi GASAK_DIST_TOKEN — wajib ada sebelum server di-restart
# Kalau gak ada, endpoint /getenv bakal 503 dan installer semua orang gagal
if [ -z "${GASAK_DIST_TOKEN:-}" ]; then
    err "GASAK_DIST_TOKEN env var tidak di-set di server!"
    err "Endpoint /getenv akan 503 — installer client akan gagal di Step 6."
    err ""
    err "Fix SEKALI di server supeng:"
    err "  echo 'export GASAK_DIST_TOKEN=\"gsk_dist_9f2k7x\"' >> ~/.bashrc"
    err "  source ~/.bashrc"
    err ""
    err "Deployment dibatalkan. Push ulang setelah token di-set."
    exit 1
fi
ok "GASAK_DIST_TOKEN terset (${#GASAK_DIST_TOKEN} chars)"

# Validasi Go compiler ada
if [ ! -f "$GO_BIN" ]; then
    err "Go compiler tidak ditemukan di ${GO_BIN}"
    err "Install Go dulu: https://go.dev/doc/install"
    exit 1
fi
ok "Go compiler OK: $($GO_BIN version 2>/dev/null | head -1)"

# ─── 1. CHECKOUT SOURCE CODE ──────────────────────────────────
echo -e "\n${YELLOW}[1/5] Checkout source code...${RESET}"
mkdir -p "$TARGET"
git --work-tree="$TARGET" --git-dir="$GIT_DIR" checkout -f main
ok "Source code checked out ke ${TARGET}"

cd "$TARGET"

# ─── 2. VALIDASI .ENV ADA DI SERVER ──────────────────────────
# .env tidak ada di repo (gitignore) — harus udah ada di server supeng
# sebelum deployment. Ini blocker: kalau .env gak ada, installer client
# akan gagal di Step 6 saat curl /getenv.
echo -e "\n${YELLOW}[2/5] Validasi .env & kompilasi...${RESET}"

if [ -f "${TARGET}/.env" ]; then
    chmod 600 "${TARGET}/.env"
    ok ".env ada di server: permission dikunci 600"

    # Spot-check key kritikal
    REQUIRED_KEYS=(
        "PARKEE_SSH_PASS"
        "CMS_DB_HOST" "CMS_DB_USER" "CMS_DB_PASS" "CMS_DB_NAME"
        "OUTLINE_API_KEY" "LINEAR_API_KEY"
    )
    ENV_INCOMPLETE=false
    for key in "${REQUIRED_KEYS[@]}"; do
        if ! grep -q "^${key}=" "${TARGET}/.env" 2>/dev/null; then
            warn ".env MISSING KEY: ${key}"
            ENV_INCOMPLETE=true
        fi
    done

    if [ "$ENV_INCOMPLETE" = true ]; then
        err ".env di server tidak lengkap — installer client akan gagal!"
        err "Update .env di server: ${TARGET}/.env"
        exit 1
    fi

    ok ".env key check passed"
else
    err ".env TIDAK ADA di ${TARGET}!"
    err "Installer client akan GAGAL di Step 6 (curl /getenv)."
    err ""
    err "Fix dulu sebelum push ulang:"
    err "  cp ~/Documents/Project/gasak/.env ${TARGET}/.env"
    err "  chmod 600 ${TARGET}/.env"
    exit 1
fi

# ─── 3. COMPILE GO BINARY ─────────────────────────────────────
# Backup binary lama kalau ada (buat rollback darurat)
if [ -f "./gasak" ]; then
    cp ./gasak ./gasak.bak 2>/dev/null || true
    info "Binary lama dibackup ke gasak.bak"
fi

info "Building (linux/amd64)..."
if GOOS=linux GOARCH=amd64 "$GO_BIN" build -ldflags="-s -w" -o ./gasak . 2>&1; then
    ok "Kompilasi sukses: $(du -sh ./gasak | cut -f1)"
    rm -f ./gasak.bak 2>/dev/null || true
else
    err "Kompilasi GAGAL!"
    if [ -f "./gasak.bak" ]; then
        mv ./gasak.bak ./gasak
        warn "Rollback ke binary lama."
    fi
    exit 1
fi

# ─── 4. FIX PERMISSIONS ───────────────────────────────────────
echo -e "\n${YELLOW}[3/5] Set permissions...${RESET}"

chmod +x ./gasak
chmod +x ./serve.sh   2>/dev/null || true
chmod +x ./install.sh 2>/dev/null || true
chmod 644 ./*.py      2>/dev/null || true
chmod 644 ./version.txt ./server.properties 2>/dev/null || true
chmod 600 ./.env

ok "Permissions OK"

# ─── 5. RESTART DISTRIBUTION SERVER ──────────────────────────
echo -e "\n${YELLOW}[4/5] Restart distribution server...${RESET}"

info "Membunuh proses lama di port ${PORT}..."

# Method 1: kill by port
if sudo lsof -t -i:${PORT} 2>/dev/null | xargs -r sudo kill -9 2>/dev/null; then
    ok "Proses lama di port ${PORT} dibunuh."
fi

# Method 2: pkill sebagai fallback
pkill -f "serve.sh"         2>/dev/null || true
pkill -f "GasakDistHandler" 2>/dev/null || true

sleep 2

# Verifikasi port benar-benar bebas
if sudo lsof -i:${PORT} 2>/dev/null | grep -q LISTEN; then
    err "Port ${PORT} masih dipakai! Coba manual: sudo kill -9 \$(sudo lsof -t -i:${PORT})"
    exit 1
fi
ok "Port ${PORT} bebas"

# Start server — pass GASAK_DIST_TOKEN eksplisit ke environment serve.sh
# Ini penting: git hook environment berbeda dari login shell,
# env var yang di-set di ~/.bashrc belum tentu ke-inherit sini
info "Starting serve.sh di background (dengan GASAK_DIST_TOKEN)..."
nohup env GASAK_DIST_TOKEN="$GASAK_DIST_TOKEN" bash "$TARGET/serve.sh" \
    > "$TARGET/dist_server.log" 2>&1 &
SERVER_PID=$!

sleep 3

# Verifikasi server jalan
if kill -0 $SERVER_PID 2>/dev/null; then
    ok "serve.sh jalan (PID: ${SERVER_PID})"
else
    err "serve.sh CRASH setelah start!"
    err "Cek log: tail -20 ${TARGET}/dist_server.log"
    tail -20 "$TARGET/dist_server.log" 2>/dev/null || true
    exit 1
fi

sleep 1
if sudo lsof -i:${PORT} 2>/dev/null | grep -q LISTEN || \
   ss -tlnp 2>/dev/null | grep -q ":${PORT}"; then
    ok "Port ${PORT} LISTENING"
else
    warn "Port ${PORT} belum kebaca di ss/lsof — mungkin butuh waktu lebih."
fi

# ─── 6. SMOKE TEST ────────────────────────────────────────────
echo -e "\n${YELLOW}[5/5] Smoke test endpoint...${RESET}"

sleep 2

SMOKE_FAILED=()

# Test version.txt
if curl -sSf --max-time 5 "http://localhost:${PORT}/version.txt" > /dev/null 2>&1; then
    VERSION=$(curl -sSf --max-time 5 "http://localhost:${PORT}/version.txt" 2>/dev/null | tr -d '[:space:]')
    ok "version.txt : OK (v${VERSION})"
else
    err "version.txt : FAIL"
    SMOKE_FAILED+=("version.txt")
fi

# Test install.sh
if curl -sSf --max-time 5 "http://localhost:${PORT}/install.sh" > /dev/null 2>&1; then
    ok "install.sh  : OK"
else
    err "install.sh  : FAIL"
    SMOKE_FAILED+=("install.sh")
fi

# Test gasak binary (HEAD request)
if curl -sSf --max-time 10 -I "http://localhost:${PORT}/gasak" > /dev/null 2>&1; then
    ok "gasak binary: OK"
else
    err "gasak binary: FAIL"
    SMOKE_FAILED+=("gasak")
fi

# Test /getenv — ini yang paling penting: pastiin credentials endpoint jalan
GETENV_STATUS=$(curl -sSL \
    --max-time 5 \
    -w "%{http_code}" \
    -o /dev/null \
    "http://localhost:${PORT}/getenv?token=${GASAK_DIST_TOKEN}" \
    2>/dev/null)

if [ "$GETENV_STATUS" = "200" ]; then
    ok "/getenv     : OK (credentials endpoint siap)"
elif [ "$GETENV_STATUS" = "403" ]; then
    err "/getenv     : 403 — token tidak cocok di server!"
    err "Pastiin GASAK_DIST_TOKEN di server sama dengan yang di install.sh"
    SMOKE_FAILED+=("/getenv (403 token mismatch)")
elif [ "$GETENV_STATUS" = "503" ]; then
    err "/getenv     : 503 — GASAK_DIST_TOKEN tidak ter-pass ke serve.sh"
    SMOKE_FAILED+=("/getenv (503 token missing)")
else
    err "/getenv     : FAIL (HTTP ${GETENV_STATUS})"
    SMOKE_FAILED+=("/getenv (${GETENV_STATUS})")
fi

# ─── FINAL SUMMARY ────────────────────────────────────────────
echo ""
echo -e "${CYAN}============================================${RESET}"

if [ ${#SMOKE_FAILED[@]} -eq 0 ]; then
    echo -e "${GREEN}  DEPLOYMENT SUKSES 100%!                   ${RESET}"
    echo -e "${CYAN}============================================${RESET}"
    VERSION=$(cat "$TARGET/version.txt" 2>/dev/null | tr -d '[:space:]' || echo "?")
    echo -e "  Versi   : ${GREEN}${VERSION}${RESET}"
    echo -e "  Server  : ${GREEN}http://10.70.0.110:${PORT}${RESET}"
    echo -e ""
    echo -e "  Client install command:"
    echo -e "  ${CYAN}curl -fsSL http://10.70.0.110:${PORT}/install.sh | bash${RESET}"
else
    echo -e "${YELLOW}  DEPLOYMENT SELESAI TAPI ADA MASALAH:     ${RESET}"
    echo -e "${CYAN}============================================${RESET}"
    for item in "${SMOKE_FAILED[@]}"; do
        echo -e "  ${RED}✘ ${item}${RESET}"
    done
    echo -e ""
    echo -e "  Cek log: ${CYAN}tail -50 ${TARGET}/dist_server.log${RESET}"
fi

echo -e "${CYAN}============================================${RESET}"
echo ""
